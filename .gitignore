# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Virtual environments. The dependency list lives in requirements.txt.
.venv/
venv/
env/

# Editors and IDEs
.idea/
.vscode/

# OS junk
.DS_Store
Thumbs.db

# Single plots regenerated by plots.ipynb on every run. The assembled manuscript
# figures live in publication_plots/ and are tracked.
/plots/

# Artefacts of running the notebooks on Windows, where './plots/name.png' was
# created as one file whose name contains literal backslashes.
.\\plots\\*
